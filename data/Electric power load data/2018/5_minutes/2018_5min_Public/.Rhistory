############我写的代码####################
##1
setwd("C:/Users/jyn_/Desktop/数据论文/原始数据/2018/2018年文体广场类-独墅湖图书馆数据/30分钟")
filelist = dir(pattern = ".xls")
#获取当前目录下所有的.xlsx文件
A=list()
B=c()
for (i in 1:length(filelist))
{
A[[i]] = read_excel(filelist[i], sheet = 1)#整个表
B = rbind(B, A)
}
# 加载openxlsx包
library(openxlsx)
# 定义保存文件的文件夹路径
##2
folder_path <- "C:/Users/jyn_/Desktop/2018_30min_Public"
# 创建保存文件的文件夹（如果不存在）
dir.create(folder_path, showWarnings = FALSE)
biaoti=read_xlsx("C:/Users/jyn_/Desktop/数据论文/原始数据/1.xlsx")
##3,只改命名方式表里的内容，代码不需要改
datamm=read.xlsx("C:/Users/jyn_/Desktop/数据论文/原始数据/命名方式.xlsx")
# 循环生成多个Excel文件
for (i in 1:365) {
# 创建数据框
df <- data.frame(A[i])
colnames(df) <- biaoti
df[,2]=as.numeric(df[,2])
# 创建Excel文件
wb <- createWorkbook()
addWorksheet(wb, sheetName = "Sheet1")
writeData(wb, sheet = "Sheet1", x = df)
# 保存Excel文件
file_name <- paste0(datamm[i,1], ".xlsx")
file_path <- file.path(folder_path, file_name)
saveWorkbook(wb, file = file_path, overwrite = TRUE)
}
############我写的代码####################
##1
setwd("C:/Users/jyn_/Desktop/数据论文/原始数据/2018/2018年文体广场类-独墅湖图书馆数据/5分钟")
filelist = dir(pattern = ".xls")
#获取当前目录下所有的.xlsx文件
A=list()
B=c()
for (i in 1:length(filelist))
{
A[[i]] = read_excel(filelist[i], sheet = 1)#整个表
B = rbind(B, A)
}
# 加载openxlsx包
library(openxlsx)
# 定义保存文件的文件夹路径
##2
folder_path <- "C:/Users/jyn_/Desktop/2018_5min_Public"
# 创建保存文件的文件夹（如果不存在）
dir.create(folder_path, showWarnings = FALSE)
biaoti=read_xlsx("C:/Users/jyn_/Desktop/数据论文/原始数据/1.xlsx")
##3,只改命名方式表里的内容，代码不需要改
datamm=read.xlsx("C:/Users/jyn_/Desktop/数据论文/原始数据/命名方式.xlsx")
# 循环生成多个Excel文件
for (i in 1:365) {
# 创建数据框
df <- data.frame(A[i])
colnames(df) <- biaoti
df[,2]=as.numeric(df[,2])
# 创建Excel文件
wb <- createWorkbook()
addWorksheet(wb, sheetName = "Sheet1")
writeData(wb, sheet = "Sheet1", x = df)
# 保存Excel文件
file_name <- paste0(datamm[i,1], ".xlsx")
file_path <- file.path(folder_path, file_name)
saveWorkbook(wb, file = file_path, overwrite = TRUE)
}
