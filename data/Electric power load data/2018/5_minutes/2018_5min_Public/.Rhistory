setwd("C:/Users/jyn_/Desktop/数据论文/原始数据/github/2018/5minute/2018_5min_Commercial")
filelist = dir(pattern = ".xlsx")
#获取当前目录下所有的.xlsx文件
A=list()
B=c()
for (i in 1:length(filelist))
{
A[[i]] = read.xlsx(filelist[i], sheet = 1)#整个表
AA=as.numeric(A[[i]][,2])#每个时间点对应的负荷
AA=AA[-1]#每个时间点对应的负荷
B = rbind(B, AA)
}
databg<-B
##判断是否是空值
kz=databg;
for (i in 1:365)
{
for (j in 1:288)
{
kz[i,j]=as.numeric(is.na(databg[i,j]))
if (kz[i,j]==1){
#databg[i,j]=(databg[i-1,j]+databg[i-2,j])/2 ##加井号就是原始数据
}
}
}
which(kz==1)
sum(kz)
